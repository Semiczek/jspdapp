{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_JSPD_HUB_URL": "https://hub.jspd.cz"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_JSPD_HUB_URL": "https://hub.jspd.cz"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_JSPD_HUB_URL": "https://hub.jspd.cz"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
